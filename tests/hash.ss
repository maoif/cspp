       (not (= (xxhash64-file "/etc/fstab")
               (xxhash64-file "/etc/fstab" 42 1 3))))

     ;; tag
     (mat-requires (xxhash)
       (not (= (xxhash64-bool #t)
               (xxhash64-fixnum 1))))
     (mat-requires (xxhash)
       (not (= (xxhash64-bool #f)
               (xxhash64-fixnum 0))))
     (mat-requires (xxhash)
       (not (= (xxhash64-char #\A)
