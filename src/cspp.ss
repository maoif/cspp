(library (cspp (0 0 0 10 4 1))
  (export)
  ;; Compile and retain explicit libraries without adding their bindings to (cspp).
  (import (cspp chez)
          (cspp regex)
          (cspp transducer)
          (cspp io)
          (cspp file)
          (cspp path)
          (cspp glob)
          (cspp navigator)
          (cspp system)
          (cspp hashset)
          (cspp dlist)
          (cspp array)
          (cspp treemap)
          (cspp treeset)
          (cspp bitvec)
          (cspp bittree)
          (cspp stack)
          (cspp queue)
          (cspp heap)
          (cspp dset)
          (cspp uuid)
          (cspp hash)
          (cspp format)
          (cspp optional-library)
          (cspp crypto)
          (cspp net)
          (cspp concurrency)
          (cspp cli)
          (cspp rich)
          (cspp logging)
          (cspp benchmark)
          (cspp test)
          (cspp parser)
          (cspp concurrency fiber)
          (cspp concurrency fiber-net))

  ;; The default language environment. Other libraries require explicit imports.
  (export (import (cspp chez)
                  (cspp utils)
                  (cspp control)
                  (cspp match)
                  (cspp adt)
                  (cspp list)
                  (cspp string)
                  (cspp vector)
                  (cspp for)
                  (cspp iter))))
