(library (cspp (0 0 0 10 4 1))
  (export)
  (import (chezscheme)
          ;; add libs here if you want them auto-compiled when compiling this file,
          ;; but not auto-imported when importing (cspp)
          (cspp optional-library-check)
          (cspp rich private render)
          (cspp concurrency fiber)
          (cspp concurrency fiber-net)
          (cspp parser combinator))

  ;; add libs here if you want them auto-compiled when compiling this file,
  ;; *and* auto-imported when importing (cspp)
  (export (import (cspp chez)
                  (cspp match)
                  (cspp adt)
                  (cspp string)
                  (cspp vector)
                  (cspp regex)
                  (cspp list)
                  (cspp utils)
                  (cspp control)
                  (cspp for)
                  (cspp iter)
                  (cspp transducer)
                  (cspp io)
                  (cspp file)
                  (cspp path)
                  (cspp glob)
                  (cspp navigator)
                  (cspp system)

                  (cspp hashset)
                  (cspp dlist)
                  (cspp array)
                  (cspp treemap)
                  (cspp treeset)
                  (cspp bitvec)
                  (cspp bittree)
                  (cspp stack)
                  (cspp queue)
                  (cspp heap)
                  (cspp dset)

                  (cspp uuid)
                  (cspp hash)
                  (cspp digest)
                  (cspp protobuf)
                  (cspp optional-library)
                  (cspp crypto)
                  (cspp net)
                  (cspp concurrency)
                  (cspp cli)
                  (cspp rich)
                  (cspp logging)
                  (cspp benchmark)
                  (cspp test)
                  (cspp parser))))
