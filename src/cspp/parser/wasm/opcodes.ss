(library (cspp parser wasm opcodes)
  (export wasm-opcode-descriptor? wasm-opcode-mnemonic wasm-opcode-prefix
          wasm-opcode-code wasm-opcode-immediate-shape wasm-opcode-structured-kind
          wasm-core-3-opcodes wasm-opcode-by-binary wasm-opcode-by-mnemonic)
  (import (cspp chez)
          (cspp utils))

  (define-record-type ($wasm-opcode-descriptor make-wasm-opcode-descriptor
                                             $wasm-opcode-descriptor?)
    (fields (immutable mnemonic $wasm-opcode-mnemonic)
            (immutable prefix $wasm-opcode-prefix)
            (immutable code $wasm-opcode-code)
            (immutable immediate-shape $wasm-opcode-immediate-shape)
            (immutable structured-kind $wasm-opcode-structured-kind)))

  (define wasm-opcode-prefix?
    (lambda (value)
      (or (not value)
          (and (fixnum? value) (fx<= 0 value) (fx<= value #xff)))))

  (define wasm-opcode-code?
    (lambda (value)
      (and (natural? value) (exact? value) (<= value #xffffffff))))

  #|proc:wasm-opcode-descriptor?
  Returns whether `object` is a WebAssembly opcode descriptor. `object` is tested.
  |#
  (define wasm-opcode-descriptor?
    (lambda (object)
      (pcheck () ($wasm-opcode-descriptor? object))))

  #|proc:wasm-opcode-mnemonic
  Returns the canonical mnemonic of `descriptor`. `descriptor` is an opcode descriptor.
  |#
  (define wasm-opcode-mnemonic
    (lambda (descriptor)
      (pcheck ([$wasm-opcode-descriptor? descriptor])
              ($wasm-opcode-mnemonic descriptor))))

  #|proc:wasm-opcode-prefix
  Returns the prefix byte of `descriptor`, or `#f`. `descriptor` is an opcode descriptor.
  |#
  (define wasm-opcode-prefix
    (lambda (descriptor)
      (pcheck ([$wasm-opcode-descriptor? descriptor])
              ($wasm-opcode-prefix descriptor))))

  #|proc:wasm-opcode-code
  Returns the opcode or subopcode of `descriptor`. `descriptor` is an opcode descriptor.
  |#
  (define wasm-opcode-code
    (lambda (descriptor)
      (pcheck ([$wasm-opcode-descriptor? descriptor])
              ($wasm-opcode-code descriptor))))

  #|proc:wasm-opcode-immediate-shape
  Returns the immediate shape of `descriptor`. `descriptor` is an opcode descriptor.
  |#
  (define wasm-opcode-immediate-shape
    (lambda (descriptor)
      (pcheck ([$wasm-opcode-descriptor? descriptor])
              ($wasm-opcode-immediate-shape descriptor))))

  #|proc:wasm-opcode-structured-kind
  Returns the structured kind of `descriptor`, or `#f`. `descriptor` is an opcode descriptor.
  |#
  (define wasm-opcode-structured-kind
    (lambda (descriptor)
      (pcheck ([$wasm-opcode-descriptor? descriptor])
              ($wasm-opcode-structured-kind descriptor))))

  ;; The final Core 3.0 instruction index has 496 distinct WAT mnemonics.
  ;; `select` uses its typed encoding here because it represents the general WAT syntax.
  ;; `type-data` and `type-element` normalize to vectors in their binary operand order.
  ;; `memory-data` normalizes `(dataidx memidx)` to `(memidx dataidx)`.
  ;; `table-element` normalizes `(elemidx tableidx)` to `(tableidx elemidx)`.
  ;; The two heap-type shapes construct non-nullable or nullable reference-type records.
  (define wasm-core-3-opcodes
    (vector->immutable-vector
     (vector
     ;; parametric
     (make-wasm-opcode-descriptor 'unreachable #f 0 'none #f)
     (make-wasm-opcode-descriptor 'nop #f 1 'none #f)
     ;; control/exceptions/tail-call
     (make-wasm-opcode-descriptor 'block #f 2 'block-type 'block)
     (make-wasm-opcode-descriptor 'loop #f 3 'block-type 'loop)
     (make-wasm-opcode-descriptor 'if #f 4 'block-type 'if)
     (make-wasm-opcode-descriptor 'else #f 5 'none #f)
     (make-wasm-opcode-descriptor 'throw #f 8 'tag-index #f)
     (make-wasm-opcode-descriptor 'throw-ref #f 10 'none #f)
     (make-wasm-opcode-descriptor 'end #f 11 'none #f)
     (make-wasm-opcode-descriptor 'br #f 12 'label-index #f)
     (make-wasm-opcode-descriptor 'br-if #f 13 'label-index #f)
     (make-wasm-opcode-descriptor 'br-table #f 14 'label-vector #f)
     (make-wasm-opcode-descriptor 'return #f 15 'none #f)
     (make-wasm-opcode-descriptor 'call #f 16 'function-index #f)
     (make-wasm-opcode-descriptor 'call-indirect #f 17 'call-indirect #f)
     (make-wasm-opcode-descriptor 'return-call #f 18 'function-index #f)
     (make-wasm-opcode-descriptor 'return-call-indirect #f 19 'call-indirect #f)
     (make-wasm-opcode-descriptor 'call-ref #f 20 'type-index #f)
     (make-wasm-opcode-descriptor 'return-call-ref #f 21 'type-index #f)
     ;; parametric
     (make-wasm-opcode-descriptor 'drop #f 26 'none #f)
     (make-wasm-opcode-descriptor 'select #f 28 'select-types #f)
     ;; control/exceptions/tail-call
     (make-wasm-opcode-descriptor 'try-table #f 31 'try-table 'try-table)
     ;; variable
     (make-wasm-opcode-descriptor 'local.get #f 32 'local-index #f)
     (make-wasm-opcode-descriptor 'local.set #f 33 'local-index #f)
     (make-wasm-opcode-descriptor 'local.tee #f 34 'local-index #f)
     (make-wasm-opcode-descriptor 'global.get #f 35 'global-index #f)
     (make-wasm-opcode-descriptor 'global.set #f 36 'global-index #f)
     ;; table
     (make-wasm-opcode-descriptor 'table.get #f 37 'table-index #f)
     (make-wasm-opcode-descriptor 'table.set #f 38 'table-index #f)
     ;; memory
     (make-wasm-opcode-descriptor 'i32.load #f 40 'memory-argument #f)
     (make-wasm-opcode-descriptor 'i64.load #f 41 'memory-argument #f)
     (make-wasm-opcode-descriptor 'f32.load #f 42 'memory-argument #f)
     (make-wasm-opcode-descriptor 'f64.load #f 43 'memory-argument #f)
     (make-wasm-opcode-descriptor 'i32.load8-s #f 44 'memory-argument #f)
     (make-wasm-opcode-descriptor 'i32.load8-u #f 45 'memory-argument #f)
     (make-wasm-opcode-descriptor 'i32.load16-s #f 46 'memory-argument #f)
     (make-wasm-opcode-descriptor 'i32.load16-u #f 47 'memory-argument #f)
     (make-wasm-opcode-descriptor 'i64.load8-s #f 48 'memory-argument #f)
     (make-wasm-opcode-descriptor 'i64.load8-u #f 49 'memory-argument #f)
     (make-wasm-opcode-descriptor 'i64.load16-s #f 50 'memory-argument #f)
     (make-wasm-opcode-descriptor 'i64.load16-u #f 51 'memory-argument #f)
     (make-wasm-opcode-descriptor 'i64.load32-s #f 52 'memory-argument #f)
     (make-wasm-opcode-descriptor 'i64.load32-u #f 53 'memory-argument #f)
     (make-wasm-opcode-descriptor 'i32.store #f 54 'memory-argument #f)
     (make-wasm-opcode-descriptor 'i64.store #f 55 'memory-argument #f)
     (make-wasm-opcode-descriptor 'f32.store #f 56 'memory-argument #f)
     (make-wasm-opcode-descriptor 'f64.store #f 57 'memory-argument #f)
     (make-wasm-opcode-descriptor 'i32.store8 #f 58 'memory-argument #f)
     (make-wasm-opcode-descriptor 'i32.store16 #f 59 'memory-argument #f)
     (make-wasm-opcode-descriptor 'i64.store8 #f 60 'memory-argument #f)
     (make-wasm-opcode-descriptor 'i64.store16 #f 61 'memory-argument #f)
     (make-wasm-opcode-descriptor 'i64.store32 #f 62 'memory-argument #f)
     (make-wasm-opcode-descriptor 'memory.size #f 63 'memory-index #f)
     (make-wasm-opcode-descriptor 'memory.grow #f 64 'memory-index #f)
     ;; numeric
     (make-wasm-opcode-descriptor 'i32.const #f 65 'i32 #f)
     (make-wasm-opcode-descriptor 'i64.const #f 66 'i64 #f)
     (make-wasm-opcode-descriptor 'f32.const #f 67 'f32 #f)
