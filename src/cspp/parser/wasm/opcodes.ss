  ;; These final binary encodings share WAT mnemonics with canonical rows above. Keeping exact
  ;; descriptors here lets binary decoding recover the encoding-specific immediate shape while
  ;; mnemonic lookup remains deterministic. A binary result therefore need not be in the public
  ;; canonical vector.
  (define wasm-core-3-binary-variants
    (vector->immutable-vector
     (vector
      (make-wasm-opcode-descriptor 'select #f #x1b 'none #f)
      (make-wasm-opcode-descriptor 'ref.test #xfb 21 'heap-type-nullable #f)
      (make-wasm-opcode-descriptor 'ref.cast #xfb 23 'heap-type-nullable #f))))

  (define opcode-binary-key
    (lambda (prefix code)
      (+ code (ash (if prefix (+ prefix 1) 0) 32))))

  (define add-binary-descriptor!
    (lambda (table descriptor)
      (let ([key (opcode-binary-key ($wasm-opcode-prefix descriptor)
                                    ($wasm-opcode-code descriptor))])
        (when (hashtable-ref table key #f)
          (assertion-violation
           'wasm-core-3-opcodes "duplicate binary opcode"
           (vector ($wasm-opcode-prefix descriptor) ($wasm-opcode-code descriptor))))
        (hashtable-set! table key descriptor))))

  (define add-canonical-descriptor!
    (lambda (binary-table mnemonic-table descriptor)
      (let ([mnemonic ($wasm-opcode-mnemonic descriptor)])
        (when (hashtable-ref mnemonic-table mnemonic #f)
          (assertion-violation 'wasm-core-3-opcodes "duplicate mnemonic" mnemonic))
        (add-binary-descriptor! binary-table descriptor)
        (hashtable-set! mnemonic-table mnemonic descriptor))))

  (define build-opcode-tables
    (lambda ()
      (let ([binary-table (make-eqv-hashtable)]
            [mnemonic-table (make-eq-hashtable)])
        (let loop ([index 0])
          (unless (fx= index (vector-length wasm-core-3-opcodes))
            (add-canonical-descriptor!
             binary-table mnemonic-table (vector-ref wasm-core-3-opcodes index))
            (loop (fx1+ index))))
        (let loop ([index 0])
          (unless (fx= index (vector-length wasm-core-3-binary-variants))
            (add-binary-descriptor!
             binary-table (vector-ref wasm-core-3-binary-variants index))
            (loop (fx1+ index))))
        (values (hashtable-copy binary-table #f)
                (hashtable-copy mnemonic-table #f)))))

  (define-values (wasm-opcode-binary-table wasm-opcode-mnemonic-table)
    (build-opcode-tables))

  #|proc:wasm-opcode-by-binary
  Returns the exact binary descriptor for `prefix` and `code`, or `#f`. `prefix` is `#f` or a
  prefix byte, and `code` is an exact u32 one-byte opcode or prefixed subopcode. A variant result
  may not be a member of `wasm-core-3-opcodes`; mnemonic lookup always returns its canonical row.
  |#
  (define wasm-opcode-by-binary
    (lambda (prefix code)
      (pcheck ([wasm-opcode-prefix? prefix] [wasm-opcode-code? code])
              (hashtable-ref wasm-opcode-binary-table
                             (opcode-binary-key prefix code) #f))))

  #|proc:wasm-opcode-by-mnemonic
  Returns the canonical descriptor for `mnemonic`, or `#f`. `mnemonic` is a symbol.
  |#
  (define wasm-opcode-by-mnemonic
    (lambda (mnemonic)
      (pcheck ([symbol? mnemonic])
              (hashtable-ref wasm-opcode-mnemonic-table mnemonic #f))))

  )
