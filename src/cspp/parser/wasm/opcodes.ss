     (make-wasm-opcode-descriptor 'i32.ne #f 71 'none #f)
     (make-wasm-opcode-descriptor 'i32.lt-s #f 72 'none #f)
     (make-wasm-opcode-descriptor 'i32.lt-u #f 73 'none #f)
     (make-wasm-opcode-descriptor 'i32.gt-s #f 74 'none #f)
     (make-wasm-opcode-descriptor 'i32.gt-u #f 75 'none #f)
     (make-wasm-opcode-descriptor 'i32.le-s #f 76 'none #f)
     (make-wasm-opcode-descriptor 'i32.le-u #f 77 'none #f)
     (make-wasm-opcode-descriptor 'i32.ge-s #f 78 'none #f)
     (make-wasm-opcode-descriptor 'i32.ge-u #f 79 'none #f)
     (make-wasm-opcode-descriptor 'i64.eqz #f 80 'none #f)
     (make-wasm-opcode-descriptor 'i64.eq #f 81 'none #f)
     (make-wasm-opcode-descriptor 'i64.ne #f 82 'none #f)
     (make-wasm-opcode-descriptor 'i64.lt-s #f 83 'none #f)
     (make-wasm-opcode-descriptor 'i64.lt-u #f 84 'none #f)
     (make-wasm-opcode-descriptor 'i64.gt-s #f 85 'none #f)
     (make-wasm-opcode-descriptor 'i64.gt-u #f 86 'none #f)
     (make-wasm-opcode-descriptor 'i64.le-s #f 87 'none #f)
     (make-wasm-opcode-descriptor 'i64.le-u #f 88 'none #f)
     (make-wasm-opcode-descriptor 'i64.ge-s #f 89 'none #f)
     (make-wasm-opcode-descriptor 'i64.ge-u #f 90 'none #f)
     (make-wasm-opcode-descriptor 'f32.eq #f 91 'none #f)
     (make-wasm-opcode-descriptor 'f32.ne #f 92 'none #f)
     (make-wasm-opcode-descriptor 'f32.lt #f 93 'none #f)
     (make-wasm-opcode-descriptor 'f32.gt #f 94 'none #f)
