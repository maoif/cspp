     (make-wasm-opcode-descriptor 'f64.lt #f 99 'none #f)
     (make-wasm-opcode-descriptor 'f64.gt #f 100 'none #f)
     (make-wasm-opcode-descriptor 'f64.le #f 101 'none #f)
     (make-wasm-opcode-descriptor 'f64.ge #f 102 'none #f)
     (make-wasm-opcode-descriptor 'i32.clz #f 103 'none #f)
     (make-wasm-opcode-descriptor 'i32.ctz #f 104 'none #f)
     (make-wasm-opcode-descriptor 'i32.popcnt #f 105 'none #f)
     (make-wasm-opcode-descriptor 'i32.add #f 106 'none #f)
     (make-wasm-opcode-descriptor 'i32.sub #f 107 'none #f)
     (make-wasm-opcode-descriptor 'i32.mul #f 108 'none #f)
     (make-wasm-opcode-descriptor 'i32.div-s #f 109 'none #f)
     (make-wasm-opcode-descriptor 'i32.div-u #f 110 'none #f)
     (make-wasm-opcode-descriptor 'i32.rem-s #f 111 'none #f)
     (make-wasm-opcode-descriptor 'i32.rem-u #f 112 'none #f)
     (make-wasm-opcode-descriptor 'i32.and #f 113 'none #f)
     (make-wasm-opcode-descriptor 'i32.or #f 114 'none #f)
     (make-wasm-opcode-descriptor 'i32.xor #f 115 'none #f)
     (make-wasm-opcode-descriptor 'i32.shl #f 116 'none #f)
     (make-wasm-opcode-descriptor 'i32.shr-s #f 117 'none #f)
     (make-wasm-opcode-descriptor 'i32.shr-u #f 118 'none #f)
     (make-wasm-opcode-descriptor 'i32.rotl #f 119 'none #f)
